  "narrative": {
    "northStar": "The Engineering Monograph",
    "overview": "Vamez gives an author and engineer a direct, material presence. Concrete gray, dense black typography and a cobalt action create the character of a pragmatic engineering publication. Scale, whitespace and thin rules carry the composition.\n\nThe system is brutal, beautiful, simple and pragmatic. Surfaces remain open; typography establishes hierarchy. Content appears immediately, and controls express their purpose without decoration.",
    "keyCharacteristics": [
      "Heavy Cyrillic and Latin typography from one family.",
      "Open sections with thin functional separators.",
      "Square controls and a restrained cobalt accent.",
      "Responsive columns that become a clear reading sequence.",
      "Immediate theme changes and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Action Color Rule",
        "body": "Accent color marks interaction and feedback; it does not become a decorative section background.",
        "section": "colors"
      },
      {
        "name": "The Single Family Rule",
        "body": "Typography gains contrast through scale and weight within Golos Text rather than through extra display faces.",
        "section": "typography"
      },
      {
        "name": "The Open Surface Rule",
        "body": "Present content as open sections and ruled rows. Reserve filled neutral surfaces for temporary reading content, error content and interaction states.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Golos Text, the shared palette and square geometry.",
      "Do let scale, whitespace and thin rules explain hierarchy.",
      "Do preserve readable Russian and English wrapping at small widths.",
      "Do keep keyboard focus, semantic landmarks and real anchor destinations.",
      "Do use motion only for functional navigation or article state changes, respecting reduced motion."
    ],
    "donts": [
      "Don't wrap ordinary content in decorative cards or grids.",
      "Don't add rounded controls, shadows or ornamental section backgrounds.",
      "Don't add typing effects, delayed reveals or decorative entrance animation.",
      "Don't turn contact navigation into a modal.",
      "Don't invent projects, achievements or client claims to fill the layout."
    ]
  }
}
