    {
      "name": "Primary contact action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A square accent action with a real contact-section destination.",
      "html": "<a class=\"ds-primary\" href=\"#contacts\">Связаться<svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"/><path d=\"M7 17 17 7\"/></svg></a>",
      "css": ".ds-primary{font-family:var(--font-body,'Golos Text',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);display:inline-flex;gap:2rem;align-items:center;justify-content:space-between;min-height:3.75rem;padding:1rem 1.5rem;font-size:0.9375rem;font-weight:600;color:var(--ink-on-accent,#fff);text-decoration:none;background:var(--card-accent,#254deb);border:0;border-radius:0;cursor:pointer}.ds-primary:hover{background:color-mix(in srgb,var(--card-accent,#254deb) 85%,var(--ink,#141414))}.ds-primary:focus-visible{outline:2px solid currentColor;outline-offset:5px;}"
    },
    {
      "name": "Header navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Plain section anchors; the complete header hides these links below 600px.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Навигация по странице\"><a class=\"ds-nav-link\" href=\"#about\">Обо мне</a><a class=\"ds-nav-link\" href=\"#contacts\">Контакты</a></nav>",
      "css": ".ds-nav{font-family:var(--font-body,'Golos Text',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);display:flex;gap:clamp(1rem,3vw,3rem);align-items:center}.ds-nav-link{display:inline-flex;align-items:center;min-height:2.75rem;font-size:0.875rem;font-weight:500;color:var(--ink,#141414);text-decoration:none;text-underline-offset:0.2em}.ds-nav-link:hover{text-decoration:underline}.ds-nav-link:focus-visible{outline:2px solid currentColor;outline-offset:5px;}"
    },
    {
      "name": "Paired site controls",
      "kind": "custom",
      "refersTo": "site-control",
      "description": "Language link and theme button share an outlined square-target group. Preview shows appearance only.",
      "html": "<div class=\"ds-controls\"><a class=\"ds-control\" href=\"/en\" aria-label=\"Переключить язык\">RU</a><span class=\"ds-control-divider\" aria-hidden=\"true\"></span><button class=\"ds-control\" type=\"button\" aria-label=\"Включить тёмную тему\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401\"/></svg></button></div>",
      "css": ".ds-controls{font-family:var(--font-body,'Golos Text',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);display:inline-flex;align-items:center;color:var(--ink,#141414);border:1px solid var(--line,#babbb4)}.ds-control{display:grid;place-items:center;width:2.75rem;height:2.75rem;padding:0;font-size:0.75rem;font-weight:600;color:inherit;text-decoration:none;background:transparent;border:0;border-radius:0;cursor:pointer}.ds-control:hover{background:var(--card-soft,#d8d8d3)}.ds-control:focus-visible{outline:2px solid currentColor;outline-offset:5px;}.ds-control-divider{align-self:stretch;width:1px;background:var(--line,#babbb4)}"
    },
