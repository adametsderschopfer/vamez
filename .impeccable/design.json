      "css": ".ds-contact{font-family:var(--font-body,'Golos Text',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);border-top:1px solid var(--line,#babbb4);border-bottom:1px solid var(--line,#babbb4)}.ds-contact-link{display:flex;gap:1rem;align-items:center;min-height:4.75rem;padding:1.25rem 0;color:var(--ink,#141414);text-decoration:none;background:transparent}.ds-contact-link:hover,.ds-contact-link:focus-visible{color:var(--card-accent,#254deb)}.ds-contact-link:focus-visible{outline:2px solid currentColor;outline-offset:5px;}.ds-contact-text{display:grid;gap:0.35rem;min-width:0}.ds-contact-label{font-size:1.2rem;font-weight:600;letter-spacing:-0.02em}.ds-contact-detail{font-size:0.875rem;line-height:1.4;color:var(--ink-muted,#565652);overflow-wrap:anywhere}.ds-contact-link svg{flex:none;margin-left:auto}"
