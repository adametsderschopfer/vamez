      "html": "<div class=\"ds-archive\"><button class=\"ds-archive-row\" type=\"button\"><span class=\"ds-archive-category\">Демонстрационный проект</span><span class=\"ds-archive-content\"><span class=\"ds-archive-title\">IT Track</span><span class=\"ds-archive-summary\">Концепты инженерных проектов — от архитектуры сервисов до интерфейсов.</span></span><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"/><path d=\"M7 17 17 7\"/></svg></button></div>",
      "css": ".ds-archive{font-family:var(--font-body,'Golos Text',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif);border-bottom:1px solid var(--line,#babbb4)}.ds-archive-row{display:grid;grid-template-columns:minmax(6.5rem,0.28fr) minmax(0,1fr) auto;gap:clamp(1rem,2vw,2rem);align-items:start;width:100%;padding:clamp(1.5rem,2.5vw,2rem) 1rem;color:var(--ink,#141414);text-align:left;background:transparent;border:0;border-radius:var(--control-radius,0);cursor:pointer}.ds-archive-row:hover{background:var(--card-surface,#f4f4f0)}.ds-archive-row:focus-visible{outline:2px solid var(--card-accent,#254deb);outline-offset:0.2rem;}.ds-archive-category{padding-top:0.25rem;font-size:0.85rem;line-height:1.5;color:var(--ink-muted,#565652)}.ds-archive-content{display:grid;gap:0.75rem;min-width:0}.ds-archive-title{font-size:clamp(1.5rem,2.4vw,2.4rem);font-weight:600;line-height:1.15;letter-spacing:-0.03em}.ds-archive-summary{max-width:60ch;font-size:0.95rem;line-height:1.6}.ds-archive-row svg{margin-top:0.25rem}.ds-archive-row:hover .ds-archive-title,.ds-archive-row:hover svg{color:var(--card-accent,#254deb)}@media(max-width:560px){.ds-archive-row{grid-template-columns:minmax(0,1fr) auto;row-gap:1rem;padding-right:0;padding-left:0}.ds-archive-category{grid-column:1;padding:0}.ds-archive-content{grid-row:2;grid-column:1/-1}.ds-archive-row svg{grid-row:1;grid-column:2;margin:0}}"
